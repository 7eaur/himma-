    {
      "id": "L3-01-IC-A02",
      "role": "independent_check",
      "focus": "connected_sentence_reading",
      "reference": "زَرَعَ مَاجِدٌ بَذْرَةً. سَقَاهَا كُلَّ صَبَاحٍ.",
