    {
      "id": "L3-02-GP-03",
      "role": "guided_practice",
      "focus": "short_text_reading",
      "reference": "جَلَسَ فَهْدٌ قُرْبَ النَّافِذَةِ. شَاهَدَ الْعَصَافِيرَ فَوْقَ الشَّجَرَةِ. كَتَبَ عَنْهَا جُمْلَةً فِي دَفْتَرِهِ.",
      "group": "l3_lessons"
    },
    {
      "id": "L3-02-GP-04",
      "role": "guided_practice",
      "focus": "short_text_reading",
      "reference": "حَمَلَتْ لَيَانُ سَلَّةً صَغِيرَةً. وَضَعَتْ فِيهَا التُّفَّاحَ. قَدَّمَتْهَا لِأُمِّهَا عِنْدَ الْغَدَاءِ.",
      "group": "l3_lessons"
    },
    {
      "id": "L3-02-IC-A01",
      "role": "independent_check",
      "focus": "short_text_reading",
      "reference": "زَارَتْ هِبَةُ جَدَّتَهَا بَعْدَ الْمَدْرَسَةِ. جَلَسَتَا فِي الْحَدِيقَةِ. حَدَّثَتْهَا الْجَدَّةُ عَنِ النَّبَاتَاتِ.",
      "group": "l3_lessons"
    },
    {
      "id": "L3-02-IC-A02",
      "role": "independent_check",
      "focus": "short_text_reading",
      "reference": "عَادَ نَاصِرٌ مِنَ السُّوقِ. أَحْضَرَ خُبْزًا وَفَاكِهَةً. رَتَّبَ الْمُشْتَرَيَاتِ مَعَ أُخْتِهِ.",
