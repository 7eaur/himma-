    {
      "id": "L3-01-IC-A01",
      "role": "independent_check",
      "focus": "connected_sentence_reading",
      "reference": "فَتَحَتْ لَيْلَى النَّافِذَةَ. دَخَلَ الْهَوَاءُ إِلَى الْغُرْفَةِ.",
