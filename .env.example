DATABASE_URL=postgresql://himma:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/himma_db
API_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_LOCAL_RESEARCHER_PASSWORD
SEED_DEMO_STUDENTS=false
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=REPLACE_WITH_LOCAL_ACCESS_KEY
S3_SECRET_KEY=REPLACE_WITH_LOCAL_SECRET_KEY
S3_BUCKET_NAME=himma-audio
REDIS_URL=redis://localhost:6379/0
NEXT_PUBLIC_API_URL=http://localhost:8000

# Speech analysis — Azure Speech is the primary M08 evaluation provider.
# Leave HIMMA_ASR_PROVIDER blank until the resource endpoint/key are configured securely.
HIMMA_ASR_PROVIDER=
HIMMA_AZURE_SPEECH_ENDPOINT=
HIMMA_AZURE_SPEECH_API_KEY=
# Region is required by the separate experimental Pronunciation Assessment REST endpoint.
HIMMA_AZURE_SPEECH_REGION=eastus
# Keep reference phrase hints disabled until Speech Lab calibration proves they are safe.
HIMMA_AZURE_SPEECH_REFERENCE_HINT=false
HIMMA_AZURE_SPEECH_TIMEOUT_SECONDS=45

# Experimental Speech Lab pronunciation assessment only — never academic scoring before calibration.
# Azure currently supports Arabic Pronunciation Assessment for ar-SA and ar-EG, not ar-OM.
# Lexical ASR remains ar-OM; this locale is intentionally separate.
HIMMA_AZURE_PRONUNCIATION_LOCALE=ar-SA
HIMMA_AZURE_PRONUNCIATION_ENDPOINT=
HIMMA_AZURE_PRONUNCIATION_TIMEOUT_SECONDS=30

# Google STT V2 remains optional only as a later benchmark against the same recordings.
HIMMA_GOOGLE_CLOUD_PROJECT=
HIMMA_GOOGLE_STT_LOCATION=global
HIMMA_GOOGLE_STT_MODEL=short
HIMMA_GOOGLE_STT_REFERENCE_BOOST=0
HIMMA_GOOGLE_STT_TIMEOUT_SECONDS=30
# GOOGLE_APPLICATION_CREDENTIALS=C:/secure/path/himma-google-service-account.json

# These stay blank until representative recordings establish a calibration version/threshold.
HIMMA_ASR_CONFIDENCE_THRESHOLD=
HIMMA_ASR_CALIBRATION_VERSION=

# TEMPORARY — set false only after the production audio pipeline is activated and validated.
HIMMA_TEMP_AUDIO_SKIP=true
ENV=development