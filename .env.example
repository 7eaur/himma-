DATABASE_URL=postgresql://himma:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/himma_db
API_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_LOCAL_RESEARCHER_PASSWORD
SEED_DEMO_STUDENTS=false
# Study-wide admission limit, including inactive accounts. Change only through reviewed deployment configuration.
HIMMA_MAX_STUDENTS=50
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=REPLACE_WITH_LOCAL_ACCESS_KEY
S3_SECRET_KEY=REPLACE_WITH_LOCAL_SECRET_KEY
S3_BUCKET_NAME=himma-audio
REDIS_URL=redis://localhost:6379/0
NEXT_PUBLIC_API_URL=http://localhost:8000
# Student recording bypass was removed. Recordings await supervisor review until approved ASR integration.
ENV=development

# Speech model governance:
# Student recordings NEVER use an external provider merely because credentials exist.
# HIMMA_ASR_PROVIDER remains blocked until the code-level runtime provider registry is approved.
HIMMA_ASR_PROVIDER=

# Supervisor Speech Lab only — non-academic evaluation using synthetic/ad-hoc recordings.
# Supported: azure-speech | google-stt-v2
HIMMA_SPEECH_LAB_PROVIDER=

# Azure lexical evaluation (Fast Transcription)
HIMMA_AZURE_SPEECH_ENDPOINT=
HIMMA_AZURE_SPEECH_API_KEY=
HIMMA_AZURE_SPEECH_REFERENCE_HINT=false
HIMMA_AZURE_SPEECH_TIMEOUT_SECONDS=45

# Azure pronunciation evaluation (lab only; Arabic candidate locales ar-SA/ar-EG)
HIMMA_AZURE_SPEECH_REGION=
HIMMA_AZURE_PRONUNCIATION_ENDPOINT=
HIMMA_AZURE_PRONUNCIATION_LOCALE=ar-SA
HIMMA_AZURE_PRONUNCIATION_TIMEOUT_SECONDS=30

# Google STT V2 lexical benchmark (lab only)
HIMMA_GOOGLE_CLOUD_PROJECT=
HIMMA_GOOGLE_STT_LOCATION=global
HIMMA_GOOGLE_STT_MODEL=short
HIMMA_GOOGLE_STT_REFERENCE_BOOST=0
HIMMA_GOOGLE_STT_TIMEOUT_SECONDS=30
