DATABASE_URL=postgresql://himma:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/himma_db
# Docker Compose database credentials must match DATABASE_URL.
DB_USER=himma
DB_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
DB_NAME=himma_db
API_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_LOCAL_RESEARCHER_PASSWORD
SEED_DEMO_STUDENTS=false
# Study-wide admission limit, including inactive accounts. Change only through reviewed deployment configuration.
HIMMA_MAX_STUDENTS=50
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=REPLACE_WITH_LOCAL_ACCESS_KEY
S3_SECRET_KEY=REPLACE_WITH_LOCAL_SECRET_KEY
S3_BUCKET_NAME=himma-audio
REDIS_URL=redis://localhost:6379/0
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
# Native reading is enabled only in an explicitly configured environment.
HIMMA_V2_NATIVE_READING_ENABLED=0
ENV=development
